// N5Deal Marketplace — Prisma schema
//
// Phase 0: Better Auth models only. The domain models (BuyerProfile, Asset,
// Inquiry, AuditLog) land in Phase 1 — see plan.md and CLAUDE.md → Data Model.
//
// The four Better Auth models below are a contract: Better Auth reads and
// writes them itself. Do not rename or drop their fields. The only hand-added
// columns are the `additionalFields` on User (role, status, companyName),
// which must ALSO be declared in the Better Auth config or they never appear
// on `session.user`.

generator client {
  // Prisma 7: the "prisma-client" generator (ESM). Output is gitignored and
  // regenerated by the `postinstall` hook, including on Vercel.
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URLs are wired in prisma.config.ts, not here (Prisma 7):
  //   DATABASE_URL — Supabase pooler, :6543 (?pgbouncer=true&connection_limit=1)
  //   DIRECT_URL   — direct, :5432 — migrations only
}

// ============================================================================
//  Enums shared by auth and domain
// ============================================================================

enum Role {
  BUYER
  SELLER
  MANAGER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

// ============================================================================
//  Better Auth managed models
// ============================================================================

model User {
  id            String   @id // generated by Better Auth, not cuid()
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) // Boolean, not a date
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // additionalFields — declared here AND in lib/auth.ts
  role        Role       @default(BUYER)
  status      UserStatus @default(ACTIVE)
  companyName String? // Seller-only, optional. No SellerProfile table — see CLAUDE.md.

  sessions Session[]
  accounts Account[]

  @@index([role, status])
  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique // session token in the httpOnly cookie
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  // One row = one sign-in method. For email+password: providerId="credential"
  // and the scrypt hash lives in `password`.
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}
