// N5Deal Marketplace — Prisma schema
//
// See CLAUDE.md → Data Model for the reasoning behind these shapes.
//
// The four Better Auth models below are a contract: Better Auth reads and
// writes them itself. Do not rename or drop their fields. The only hand-added
// columns are the `additionalFields` on User (role, status, companyName),
// which must ALSO be declared in the Better Auth config or they never appear
// on `session.user`.

generator client {
  // Prisma 7: the "prisma-client" generator (ESM). Output is gitignored and
  // regenerated by the `postinstall` hook, including on Vercel.
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URLs are wired in prisma.config.ts, not here (Prisma 7):
  //   DATABASE_URL — Supabase pooler, :6543 (?pgbouncer=true&connection_limit=1)
  //   DIRECT_URL   — direct, :5432 — migrations only
}

// ============================================================================
//  Enums shared by auth and domain
// ============================================================================

enum Role {
  BUYER
  SELLER
  MANAGER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

// ============================================================================
//  Better Auth managed models
// ============================================================================

model User {
  id            String   @id // generated by Better Auth, not cuid()
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) // Boolean, not a date
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // additionalFields — declared here AND in lib/auth.ts
  role        Role       @default(BUYER)
  status      UserStatus @default(ACTIVE)
  companyName String? // Seller-only, optional. No SellerProfile table — see CLAUDE.md.

  sessions Session[]
  accounts Account[]

  // Domain relations
  buyerProfile      BuyerProfile?
  assets            Asset[]       @relation("SellerAssets")
  sentInquiries     Inquiry[]     @relation("InquiriesFrom")
  receivedInquiries Inquiry[]     @relation("InquiriesTo")
  auditActions      AuditLog[]    @relation("AuditActor")

  @@index([role, status])
  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique // session token in the httpOnly cookie
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  // One row = one sign-in method. For email+password: providerId="credential"
  // and the scrypt hash lives in `password`.
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ============================================================================
//  Domain models
// ============================================================================

// What a Buyer is looking for. Drives Smart Matching (src/lib/matching.ts).
// The brief gives a profile to Buyers only — Sellers get User.companyName.
model BuyerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  industries  String[]
  regions     String[]
  budgetMin   Int? // whole EUR
  budgetMax   Int?
  description String?
  updatedAt   DateTime @updatedAt
}

enum AssetCategory {
  LICENSE
  OPERATING_BUSINESS
  STAKE
}

// The state of the company being sold. NOT the same thing as ListingStatus.
enum BusinessStatus {
  ACTIVE
  DORMANT
  IN_LIQUIDATION
}

// The moderation state of the listing itself.
enum ListingStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

model Asset {
  id       String @id @default(cuid())
  sellerId String
  seller   User   @relation("SellerAssets", fields: [sellerId], references: [id])

  // ----- Common fields, every category -----
  title             String
  category          AssetCategory
  country           String
  industry          String
  businessStatus    BusinessStatus @default(ACTIVE)
  askingPrice       Int // whole EUR — never Decimal, see CLAUDE.md pitfall 3
  employees         String?
  yearFounded       Int?
  description       String
  keyAssetsIncluded String[]
  listingStatus     ListingStatus  @default(ACTIVE)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // ----- Category-specific -----
  // All nullable at the DB level; required-by-category in the Zod
  // discriminated union. Prisma cannot express "required only when
  // category = X", and a per-category table would be three joins for a
  // prototype that never queries them separately.

  // LICENSE
  regulatoryBody String?
  licenseType    String?

  // OPERATING_BUSINESS
  annualRevenue Int?
  reasonForSale String?

  // STAKE (reuses annualRevenue — a stake sale still has a revenue figure)
  stakePercentage Int?

  inquiries Inquiry[]

  // Buyer browse always filters on listingStatus first, then category/country.
  @@index([listingStatus, category, country])
  @@index([sellerId])
}

// The contact flow, deliberately not a chat: one message, one row.
// assetId is nullable because a Seller contacting a Buyer is not about
// a specific listing.
model Inquiry {
  id         String   @id @default(cuid())
  fromUserId String
  from       User     @relation("InquiriesFrom", fields: [fromUserId], references: [id])
  toUserId   String
  to         User     @relation("InquiriesTo", fields: [toUserId], references: [id])
  assetId    String?
  asset      Asset?   @relation(fields: [assetId], references: [id])
  message    String
  createdAt  DateTime @default(now())

  @@index([toUserId, createdAt])
  @@index([fromUserId, createdAt])
}

enum AuditAction {
  SUSPEND_USER
  REMOVE_USER
  REACTIVATE_USER
  SUSPEND_ASSET
  REMOVE_ASSET
}

// Every Manager moderation action, written inside the same transaction as the
// change itself. This is what makes REMOVED a soft delete worth having.
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String
  actor      User        @relation("AuditActor", fields: [actorId], references: [id])
  action     AuditAction
  targetType String // "USER" | "ASSET"
  targetId   String
  reason     String?
  createdAt  DateTime    @default(now())

  @@index([createdAt])
}
